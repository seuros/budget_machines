module BudgetMachines
  VERSION: String
  CAPACITY: Integer
  MILLI: Integer

  type state = :no_data | :quiet | :firing
  type change = :none | :raised | :cleared
  type on_no_data = :hold | :reset | :fire
  # Every symbol that means "this call was not honoured and changed nothing".
  # Each method below lists exactly the ones it can answer.
  type refusal = :stale_period | :overflow | :below_observed | :full | :shape | :time_regression
  # A window reading: :no_data when the caller has none, or exact counts.
  type sample = :no_data | Sample::Counts

  # Every Data value validates through the core when built, by hand or by the
  # gem: a wrong type raises TypeError, a value the core rejects RangeError.

  # `good <= total`, both in 0..2**64-1; anything else raises TypeError or RangeError.
  class Counts < Data
    attr_reader good: Integer
    attr_reader total: Integer
    def self.new: (Integer good, Integer total) -> Counts
                | (good: Integer, total: Integer) -> Counts
    def bad: () -> Integer
    # nil when a sum would pass 2**64-1; TypeError unless `other` is a Counts.
    def checked_add: (Counts other) -> Counts?
  end

  # `good < per`, both in 0..2**32-1; anything else raises TypeError or RangeError.
  class Objective < Data
    attr_reader good: Integer
    attr_reader per: Integer
    def self.new: (Integer good, Integer per) -> Objective
                | (good: Integer, per: Integer) -> Objective
    def tolerated: () -> Integer
    def allowance: (Integer total) -> Integer
    def burn_milli_of: (Integer bad, Integer total) -> Integer?
    def burn_milli: (Counts counts) -> Integer?
    def burns_at_least: (Counts counts, Integer threshold_milli) -> bool
  end

  module Sample
    class Counts < Data
      attr_reader counts: BudgetMachines::Counts
      def self.new: (BudgetMachines::Counts counts) -> Counts
                  | (counts: BudgetMachines::Counts) -> Counts
    end
  end

  module Standing
    # 0..2**64-1, like Exhausted's `overspent`.
    class Within < Data
      attr_reader remaining: Integer
      def self.new: (Integer remaining) -> Within
                  | (remaining: Integer) -> Within
    end

    class Exhausted < Data
      attr_reader overspent: Integer
      def self.new: (Integer overspent) -> Exhausted
                  | (overspent: Integer) -> Exhausted
    end
  end

  type standing = :no_data | Standing::Within | Standing::Exhausted

  # `Account::new`: RangeError for fields no ledger could produce (base below
  # the observed total, allowance above the base, a standing the counts and
  # allowance do not give, a consumed_milli inconsistent with them).
  class Account < Data
    attr_reader period: Integer
    attr_reader counts: Counts
    attr_reader base: Integer
    attr_reader allowance: Integer
    attr_reader standing: standing
    attr_reader consumed_milli: Integer?
    def self.new: (Integer period, Counts counts, Integer base, Integer allowance, standing standing,
                   Integer? consumed_milli) -> Account
                | (period: Integer, counts: Counts, base: Integer, allowance: Integer, standing: standing,
                   consumed_milli: Integer?) -> Account
  end

  # A Symbol other than :no_data raises RangeError; any other type TypeError.
  class Windows < Data
    attr_reader long: sample
    attr_reader short: sample
    def self.new: (sample long, sample short) -> Windows
                | (long: sample, short: sample) -> Windows
  end

  # `0 < clear_milli <= fire_milli`, both in 0..2**32-1; `severity` in 0..255.
  class Rule < Data
    attr_reader fire_milli: Integer
    attr_reader clear_milli: Integer
    attr_reader severity: Integer
    def self.new: (Integer fire_milli, Integer clear_milli, Integer severity) -> Rule
                | (fire_milli: Integer, clear_milli: Integer, severity: Integer) -> Rule
  end

  # `Decision::new`: RangeError for an edge into the wrong state or without its
  # instant, both rates (a measurement) with state :no_data, or an unknown
  # state/change Symbol.
  class Decision < Data
    attr_reader state: state
    attr_reader change: change
    attr_reader long_milli: Integer?
    attr_reader short_milli: Integer?
    # Instant the rule entered `state`, Integer nanoseconds; nil if it never changed.
    attr_reader since: Integer?
    def self.new: (state state, change change, Integer? long_milli, Integer? short_milli,
                   Integer? since) -> Decision
                | (state: state, change: change, long_milli: Integer?, short_milli: Integer?,
                   since: Integer?) -> Decision
    # Both burn rates known; false when the no-data policy decided `state`.
    def measured?: () -> bool
  end

  # `Verdict::new`: RangeError for more than CAPACITY decisions, a `worst`
  # that is not a firing decision's index, or nil while one fires.
  class Verdict < Data
    # Frozen.
    attr_reader decisions: Array[Decision]
    attr_reader worst: Integer?
    def self.new: (Array[Decision] decisions, Integer? worst) -> Verdict
                | (decisions: Array[Decision], worst: Integer?) -> Verdict
  end

  class Ledger
    def self.new: (Objective objective, Integer period) -> Ledger
    def objective: () -> Objective
    def period: () -> Integer
    def counts: () -> Counts
    # Honoured: :ok. Refused: :stale_period, :overflow.
    def record: (Integer period, Counts counts) -> (:ok | :stale_period | :overflow)
    # Honoured: :ok. Refused: :stale_period.
    def replace: (Integer period, Counts counts) -> (:ok | :stale_period)
    # Honoured: the closed period's Account. Refused: :stale_period.
    def roll: (Integer period) -> (Account | :stale_period)
    def account: () -> Account
    # A pure query. Refused: :below_observed.
    def account_against: (Integer planned_total) -> (Account | :below_observed)
  end

  class Monitor
    def self.new: (Objective objective, on_no_data policy, Integer min_total) -> Monitor
    # Honoured: the rule's index. Refused: :full.
    def add_rule: (Rule rule) -> (Integer | :full)
    def size: () -> Integer
    def empty?: () -> bool
    def capacity: () -> Integer
    def objective: () -> Objective
    def rule: (Integer index) -> Rule?
    def state: (Integer index) -> state?
    # Instant of the latest accepted evaluation, Integer nanoseconds.
    def last: () -> Integer?
    def worst: () -> Integer?
    # `now` is Integer nanoseconds of monotonic time. Honoured: a Verdict,
    # and `now` is recorded (every verdict is the rules' state as of `now`).
    # Refused: :time_regression, :shape, recording nothing.
    def evaluate: (Integer now, Array[Windows] windows) -> (Verdict | :time_regression | :shape)
  end
end
